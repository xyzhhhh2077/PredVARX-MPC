# MATLAB autosave and backup files
*.asv
*.m~
*.autosave

# MATLAB temporary files
*.tmp
*.temp

# MATLAB / Simulink generated folders
slprj/
codegen/

# MEX compiled files
*.mex*

# Large MATLAB data/results files: track manually only if needed
*.mat

# Figures can become large; track manually only if they are final paper figures
*.fig

# Common generated outputs
*.log
*.out
*.cache

# Per-experiment PNG figures (generated; do not track. README mentions paper-level figures explicitly)
experiments/*/results/*.png

# Stray PDFs dropped into experiments (e.g., downloaded plant PDFs, teaching copies)
experiments/*.pdf

# Literature download cache (PDFs + analysis .md) -- too large, should live outside this git repo
experiments/_lit_dl/
experiments/_tmp_*.txt

# Teaching PPT project (separate repo concern; not part of MATLAB identifier suite)
projects/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor folders
.vscode/
.idea/
