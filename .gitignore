# MATLAB autosave and backup files
*.asv
*.m~
*.autosave

# MATLAB temporary files
*.tmp
*.temp

# MATLAB / Simulink generated folders
slprj/
codegen/

# MEX compiled files
*.mex*

# Common generated outputs
*.log
*.out
*.cache

# Stray PDFs dropped into experiments (not part of MATLAB copy suite)
experiments/*.pdf

# Literature download cache (PDFs + analysis) -- keep outside this repo
experiments/_lit_dl/
experiments/_tmp_*.txt

# Teaching PPT project (separate concern)
projects/

# Local one-off editor helpers (not experiment code)
seqedit.bat
seqedit.py

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor folders
.vscode/
.idea/

